# ==============================================================================
# SANAD Abu Dhabi - Environment Configuration
# ==============================================================================

# Server Port (Default: 3000)
PORT=3000

# Google Gemini API Configuration (Recommended)
# Model options: gemini-3.8-flash (default), gemini-2.5-flash, gemini-1.5-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenAI Alternative (Optional)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
